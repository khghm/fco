# نمونه پیکربندی محیط توسعه — هیچ مقدار واقعی/حساسی در این فایل نیست
# فایل واقعی: .env (در .gitignore)

# --- پایگاه داده (محیط محلی) ---
POSTGRES_DB=fco
POSTGRES_USER=fco
POSTGRES_PASSWORD=fco_local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fco:fco_local_dev_only@localhost:5432/fco

# --- صف/کش (ADR-008: صف روی PostgreSQL؛ Redis برای کش و قفل کوتاه) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- ذخیره‌سازی فایل (S3-compatible) — اختیاری در توسعه (D-09) ---
# اجرا فقط با: docker compose --profile storage up -d
# برای BR-1 لازم نیست؛ از BR-2 (رسانه محصول) نیاز می‌شود.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=fco_local
MINIO_ROOT_PASSWORD=fco_local_dev_only
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=fco-media
S3_REGION=us-east-1

# --- برنامه ---
APP_ENV=development
APP_ORIGIN=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Tehran
CURRENCY_STORAGE_UNIT=IRR
DISPLAY_CURRENCY_UNIT=IRT

# --- یکپارچگی‌ها (در توسعه خالی و غیرفعال) ---
# PAYMENT_GATEWAY_DRIVER=simulated
# PAYMENT_GATEWAY_API_KEY=
# SMS_DRIVER=spool
# SHIPPING_DRIVER=manual
